// Method Inheritance
class animal {
    constructor(name){
        this.name = name;
        this.age = age;
    }
}
class cat extends animal{
    constructor(name,age,breed){
        super (name,age);
        this.breed = breed;
    }
}
const c =new cat("Shiba" 2,"paya");
console.log(c);